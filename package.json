{
  "name": "x402-galachain",
  "version": "0.0.1",
  "description": "Experimental x402 exact payment scheme for GALA on GalaChain.",
  "keywords": ["x402", "galachain", "gala", "payments", "facilitator"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bnskaggs/x402-galachain.git"
  },
  "homepage": "https://github.com/bnskaggs/x402-galachain#readme",
  "bugs": "https://github.com/bnskaggs/x402-galachain/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./exact/client": {
      "types": "./dist/exact/client/index.d.ts",
      "default": "./dist/exact/client/index.js"
    },
    "./exact/server": {
      "types": "./dist/exact/server/index.d.ts",
      "default": "./dist/exact/server/index.js"
    },
    "./exact/facilitator": {
      "types": "./dist/exact/facilitator/index.d.ts",
      "default": "./dist/exact/facilitator/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.harness.json",
    "test": "vitest run",
    "start": "tsx service/index.ts",
    "demo": "tsx harness/demo.ts",
    "attack": "tsx harness/gc-attack.ts",
    "new-demo-key": "tsx harness/new-key.ts"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "dependencies": {
    "@gala-chain/api": "^3.3.0",
    "@x402/core": "^2.27.0"
  },
  "peerDependencies": {
    "@x402/core": "^2.27.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.5.2",
    "@x402/express": "^2.27.0",
    "@x402/fetch": "^2.27.0",
    "express": "^5.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2"
  }
}
